{
  "version": 2,
  "units": "metres",
  "up_axis": "Z",
  "front_axis": "-Y",
  "notes": "Single source of placement, look-dev and camera keyframes. Read by assemble.py, bake.py, render_stills.py and export_glb.py. Paths are relative to the repository root. Blender (x, y, z) -> glTF/three.js (x, z, -y); app/src/data/phases.ts camera keys equal the keyframes below under that mapping (fov 34 deg vertical = 39.2 mm on a 24 mm vertical sensor).",
  "import": {
    "prefer": "obj",
    "obj_scale": 0.001,
    "note": "The Blender 5.4 STEP importer returns ONE merged mesh per file, so body names (and the name-based material rules) are lost. The SolidCraft OBJ keeps one named object per body, in millimetres, so OBJ is imported and scaled by 0.001. STEP remains the fallback when an OBJ is missing."
  },
  "optimize": {
    "tris_per_metre": 8000,
    "min_tris": 150,
    "max_tris": 6000,
    "asset_factor": {
      "district": 0.35,
      "rack": 1,
      "exchanger": 1
    },
    "note": "Objects above their triangle budget (bbox diagonal * tris_per_metre, clamped, times asset_factor) are collapse-decimated before shading. Fine tessellation of bolts, nuts, collars and manholes made the raw export ~1.4 M triangles."
  },
  "assets": {
    "rack": {
      "position": [
        -3.2,
        2,
        0
      ],
      "rotation_deg": [
        0,
        0,
        180
      ],
      "files": [
        "assets/rack/rack.step"
      ],
      "placeholder": "rack",
      "note": "600 x 1000 x 2200 mm envelope. Z 180 deg turns the front (-Y local) to face +Y world, away from the exchanger; the rear manifold ends up at world y=1.52, between rack and exchanger (the loop pipes run there). three.js position = (-3.2, 0, -2.0)."
    },
    "exchanger": {
      "position": [
        0,
        0,
        0
      ],
      "rotation_deg": [
        0,
        0,
        0
      ],
      "files": [
        "assets/exchanger/exchanger_frame.step",
        "assets/exchanger/exchanger_core.step",
        "assets/exchanger/exchanger_ports.step"
      ],
      "placeholder": "exchanger",
      "note": "hero object, 868 x 1328 x 1620 mm envelope; the -Y face carries ports x=-0.2 at z=0.5/1.05, the +Y face ports x=+0.2"
    },
    "district": {
      "position": [
        -30,
        30,
        0
      ],
      "rotation_deg": [
        0,
        0,
        0
      ],
      "files": [
        "assets/district/district.step"
      ],
      "placeholder": "district",
      "note": "240 x 240 m plot, slab top at z = 0. Offset (-30,+30) so the hero equipment (world origin) sits at district point (30,-30): in the open between the 30 m plant (now at world (-30,+30), behind the exchanger as seen from the establishing camera) and the nearest buildings, instead of inside the plant footprint."
    }
  },
